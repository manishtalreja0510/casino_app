# apps/api local development config (ADR-021: local-first, zero cost).
# Copy to `.env` (gitignored). Non-secret loopback defaults only —
# staging/prod values come from the secret manager at deploy time (ADR-011), never from a file like this.

NODE_ENV=development
APP_ENV=dev
PORT=3000

# Reserved for P1 (database/redis wiring). Present so the local stack is discoverable now.
DATABASE_URL=postgresql://casino_dev:casino_dev_local_only@127.0.0.1:5432/casino_dev
REDIS_URL=redis://127.0.0.1:6379
