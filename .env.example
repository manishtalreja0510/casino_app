# Root example env for the LOCAL development stack (ADR-021).
# Copy to `.env` (gitignored). These are throwaway loopback-only values —
# never a template for staging/prod, whose secrets come from the secret manager (ADR-011).

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=casino_dev
POSTGRES_USER=casino_dev
POSTGRES_PASSWORD=casino_dev_local_only

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
